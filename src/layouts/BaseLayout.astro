---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Tappeti persiani e orientali a Pescara — vendita, lavaggio e restauro. Oltre 30 anni di esperienza." } = Astro.props;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} · Vahid Tappeti Rari (Demo Redesign)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-base text-ink font-sans antialiased">
    <div class="fixed top-0 left-0 right-0 z-50 bg-accent text-base text-center text-xs py-1.5 px-4">
      DEMO — redesign di presentazione, non il sito ufficiale di Vahid Tappeti Rari
    </div>
    <div class="pt-7">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <CartDrawer />
    <script>
      import { initScrollReveals } from '../scripts/animations';
      import { initBeforeAfterSliders } from '../scripts/beforeAfterSlider';
      initScrollReveals();
      initBeforeAfterSliders();
    </script>
  </body>
</html>
