---
import { X, Minus, Plus, Trash2 } from '@lucide/astro';
---
<div id="cart-overlay" class="fixed inset-0 bg-ink/50 z-[60] hidden" aria-hidden="true"></div>
<aside id="cart-drawer" class="fixed top-0 right-0 h-full w-full max-w-md bg-base z-[70] translate-x-full transition-transform duration-300 shadow-2xl flex flex-col" role="dialog" aria-label="Carrello">
  <div class="flex items-center justify-between px-6 py-5 border-b border-ink/10">
    <h2 class="font-display text-xl">Il tuo carrello</h2>
    <button id="cart-close" aria-label="Chiudi carrello"><X size={20} /></button>
  </div>
  <div id="cart-items" class="flex-1 overflow-y-auto px-6 py-4 space-y-4"></div>
  <div class="border-t border-ink/10 px-6 py-5">
    <div class="flex justify-between text-sm mb-4">
      <span>Totale</span>
      <strong id="cart-total">€0,00</strong>
    </div>
    <a href="/checkout" class="block text-center w-full py-3 bg-accent text-base rounded font-medium">Vai al checkout</a>
  </div>
</aside>

<script>
  import { cart, updateQty, removeFromCart, cartTotal, type CartItem } from '../stores/cart';

  const fmt = (n: number) => n.toLocaleString('it-IT', { style: 'currency', currency: 'EUR' });

  function render() {
    const items = cart.get();
    const container = document.getElementById('cart-items')!;
    if (items.length === 0) {
      container.innerHTML = `<p class="text-sm text-ink-60">Il carrello è vuoto.</p>`;
    } else {
      container.innerHTML = items.map((i: CartItem) => `
        <div class="flex gap-3" data-slug="${i.slug}">
          <img src="${i.image}" alt="${i.name}" class="w-16 h-16 object-cover rounded" />
          <div class="flex-1">
            <p class="text-sm font-medium">${i.name}</p>
            <p class="text-xs text-ink-60">${fmt(i.price)}</p>
            <div class="flex items-center gap-2 mt-1">
              <button class="qty-dec p-1 border rounded" aria-label="Diminuisci">−</button>
              <span class="text-sm w-5 text-center">${i.qty}</span>
              <button class="qty-inc p-1 border rounded" aria-label="Aumenta">+</button>
              <button class="remove-item text-accent text-xs ml-auto">Rimuovi</button>
            </div>
          </div>
        </div>
      `).join('');
    }
    document.getElementById('cart-total')!.textContent = fmt(cartTotal(items));
  }

  document.getElementById('cart-items')?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const row = target.closest<HTMLElement>('[data-slug]');
    if (!row) return;
    const slug = row.dataset.slug!;
    const item = cart.get().find((i) => i.slug === slug);
    if (!item) return;
    if (target.classList.contains('qty-inc')) updateQty(slug, item.qty + 1);
    if (target.classList.contains('qty-dec')) updateQty(slug, item.qty - 1);
    if (target.classList.contains('remove-item')) removeFromCart(slug);
  });

  cart.subscribe(render);
  render();

  const drawer = document.getElementById('cart-drawer')!;
  const overlay = document.getElementById('cart-overlay')!;
  function open() {
    drawer.classList.remove('translate-x-full');
    overlay.classList.remove('hidden');
  }
  function close() {
    drawer.classList.add('translate-x-full');
    overlay.classList.add('hidden');
  }
  document.addEventListener('cart:toggle', open);
  document.getElementById('cart-close')?.addEventListener('click', close);
  overlay.addEventListener('click', close);
</script>
