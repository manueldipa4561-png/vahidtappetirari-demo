---
import BaseLayout from '../layouts/BaseLayout.astro';
import content from '../data/content.json';
const { about, business } = content;
---
<BaseLayout title="Chi siamo">
  <section class="max-w-4xl mx-auto px-4 md:px-8 pt-16 pb-12 text-center">
    <p class="text-xs uppercase tracking-wide text-accent mb-3" data-reveal>Chi siamo</p>
    <h1 class="font-display text-4xl md:text-5xl mb-6" data-reveal>{about.rareUniqueStatement}</h1>
    <p class="text-ink-80" data-reveal>{about.bio}</p>
  </section>

  <section class="max-w-7xl mx-auto px-4 md:px-8 py-12 grid md:grid-cols-3 gap-6">
    {about.coreValues.map((v, i) => (
      <div class="bg-base-90 border border-ink/10 rounded-lg p-8" data-reveal>
        <span class="font-display text-5xl text-accent/30">0{i + 1}</span>
        <h3 class="font-display text-2xl mt-4 mb-2">{v}</h3>
        <p class="text-sm text-ink-60">
          {v === "Qualita'" && "Ogni tappeto e' selezionato personalmente da Vahid nei paesi di origine."}
          {v === "Autenticita'" && "Provenienza certificata, nessun compromesso sull'origine dei materiali."}
          {v === 'Eleganza' && 'Design e colori naturali che si integrano in ogni ambiente.'}
        </p>
      </div>
    ))}
  </section>

  <section class="max-w-7xl mx-auto px-4 md:px-8 py-12">
    <h2 class="font-display text-3xl mb-8" data-reveal>Le nostre categorie</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      {about.categories.map((c) => (
        <div class="aspect-4/5 bg-ink text-base rounded-lg flex items-end p-5" data-reveal>
          <span class="font-display text-xl">{c}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 md:px-8 py-16 text-center" data-reveal>
    <div class="inline-flex items-center gap-3 border border-accent/40 rounded-full px-5 py-2.5 text-sm text-accent">
      {about.certification}
    </div>
  </section>
</BaseLayout>
