---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Phone, Mail, MapPin } from '@lucide/astro';
import content from '../data/content.json';
const { contact } = content;
---
<BaseLayout title="Contatti">
  <section class="max-w-4xl mx-auto px-4 md:px-8 pt-16 pb-10 text-center">
    <h1 class="font-display text-4xl md:text-5xl mb-4" data-reveal>{contact.formCta}</h1>
  </section>

  <section class="max-w-7xl mx-auto px-4 md:px-8 pb-12 grid md:grid-cols-3 gap-6">
    <a href={`tel:${contact.phone.replace(/\s+/g, '')}`} class="border border-ink/10 rounded-lg p-6 text-center hover:border-accent transition-colors" data-reveal>
      <Phone class="mx-auto mb-3 text-accent" size={24} />
      <p class="font-medium">{contact.phone}</p>
    </a>
    <div class="border border-ink/10 rounded-lg p-6 text-center" data-reveal>
      <MapPin class="mx-auto mb-3 text-accent" size={24} />
      <p class="font-medium">{contact.address}</p>
    </div>
    <a href={`mailto:${contact.email}`} class="border border-ink/10 rounded-lg p-6 text-center hover:border-accent transition-colors" data-reveal>
      <Mail class="mx-auto mb-3 text-accent" size={24} />
      <p class="font-medium">{contact.email}</p>
    </a>
  </section>

  <section class="max-w-3xl mx-auto px-4 md:px-8 py-12" data-reveal>
    <form name="contatti" method="POST" data-netlify="true" netlify-honeypot="bot-field" class="space-y-4">
      <input type="hidden" name="form-name" value="contatti" />
      <p class="hidden"><label>Non compilare: <input name="bot-field" /></label></p>
      <div class="grid md:grid-cols-2 gap-4">
        <input type="text" name="nome" required placeholder="Nome e cognome" class="px-4 py-3 border border-ink/20 rounded bg-base" />
        <input type="email" name="email" required placeholder="Email" class="px-4 py-3 border border-ink/20 rounded bg-base" />
      </div>
      <input type="tel" name="telefono" placeholder="Telefono (opzionale)" class="w-full px-4 py-3 border border-ink/20 rounded bg-base" />
      <textarea name="messaggio" required rows="5" placeholder="Messaggio" class="w-full px-4 py-3 border border-ink/20 rounded bg-base"></textarea>
      <button type="submit" class="px-8 py-3 bg-accent text-base rounded font-medium">{contact.submitLabel}</button>
    </form>
  </section>

  <section class="max-w-7xl mx-auto px-4 md:px-8 py-12" data-reveal>
    <iframe
      title="Mappa - Via Ravenna, 85, Pescara"
      class="w-full h-96 rounded-lg border-0"
      loading="lazy"
      src={`https://www.google.com/maps?q=${encodeURIComponent(contact.address)}&output=embed`}
    ></iframe>
  </section>
</BaseLayout>
