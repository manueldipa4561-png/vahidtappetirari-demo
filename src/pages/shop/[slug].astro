---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((p) => ({ params: { slug: p.id }, props: { product: p } }));
}

const { product } = Astro.props;
const { data } = product;
const fmt = new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR' }).format(data.price);
---
<BaseLayout title={data.name}>
  <section class="max-w-7xl mx-auto px-4 md:px-8 pt-12 pb-20 grid md:grid-cols-2 gap-12">
    <div data-reveal>
      <div class="aspect-square rounded-lg overflow-hidden bg-ink/5">
        <img id="main-image" src={data.images[0]} alt={data.name} class="w-full h-full object-cover" />
      </div>
      {data.images.length > 1 && (
        <div class="flex gap-2 mt-3">
          {data.images.map((img: string) => (
            <button class="thumb w-16 h-16 rounded overflow-hidden border border-ink/10" data-src={img}>
              <img src={img} alt="" class="w-full h-full object-cover" />
            </button>
          ))}
        </div>
      )}
    </div>

    <div data-reveal>
      <p class="text-xs uppercase tracking-wide text-accent mb-2">{data.category}</p>
      <h1 class="font-display text-3xl md:text-4xl mb-2">{data.name}</h1>
      <p class="text-sm text-ink-60 mb-4">Cod. {data.code} · {data.dimensions}{data.material ? ` · ${data.material}` : ''}</p>
      <p class="font-display text-2xl text-accent mb-6">{fmt}</p>

      <div class="flex items-center gap-3 mb-6">
        <div class="flex items-center border border-ink/20 rounded">
          <button id="qty-dec" class="px-3 py-2" aria-label="Diminuisci">−</button>
          <span id="qty-val" class="px-4">1</span>
          <button id="qty-inc" class="px-3 py-2" aria-label="Aumenta">+</button>
        </div>
        <button
          id="add-to-cart"
          class="flex-1 px-6 py-3 bg-accent text-base rounded font-medium"
          data-slug={product.id}
          data-name={data.name}
          data-price={data.price}
          data-image={data.images[0]}
        >Aggiungi al carrello</button>
      </div>
      <p id="add-confirm" class="text-sm text-accent hidden">Aggiunto al carrello ✓</p>

      <div class="border-t border-ink/10 pt-6 mt-6">
        <h2 class="font-medium mb-2">Descrizione</h2>
        <p class="text-sm text-ink-80">{data.description}</p>
      </div>
    </div>
  </section>

  {data.related.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 md:px-8 pb-24">
      <h2 class="font-display text-2xl mb-6" data-reveal>Potrebbe interessarti anche</h2>
      <ul class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
        {data.related.map((r: string) => (
          <li class="border border-ink/10 rounded-lg px-4 py-3 text-ink-60">{r}</li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<script>
  import { addToCart } from '../../stores/cart';

  document.querySelectorAll<HTMLElement>('.thumb').forEach((btn) => {
    btn.addEventListener('click', () => {
      const main = document.getElementById('main-image') as HTMLImageElement;
      if (main && btn.dataset.src) main.src = btn.dataset.src;
    });
  });

  let qty = 1;
  const qtyEl = document.getElementById('qty-val')!;
  document.getElementById('qty-inc')?.addEventListener('click', () => { qty++; qtyEl.textContent = String(qty); });
  document.getElementById('qty-dec')?.addEventListener('click', () => { qty = Math.max(1, qty - 1); qtyEl.textContent = String(qty); });

  document.getElementById('add-to-cart')?.addEventListener('click', (e) => {
    const btn = e.currentTarget as HTMLElement;
    addToCart({
      slug: btn.dataset.slug!,
      name: btn.dataset.name!,
      price: parseFloat(btn.dataset.price!),
      image: btn.dataset.image!,
    }, qty);
    const confirm = document.getElementById('add-confirm')!;
    confirm.classList.remove('hidden');
    setTimeout(() => confirm.classList.add('hidden'), 2000);
  });
</script>
