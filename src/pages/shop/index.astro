---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import content from '../../data/content.json';
import { getCollection } from 'astro:content';
const products = await getCollection('products');
const { shop } = content;
---
<BaseLayout title="Shop">
  <section class="max-w-7xl mx-auto px-4 md:px-8 pt-16 pb-8">
    <h1 class="font-display text-4xl md:text-5xl mb-4" data-reveal>Shop</h1>
    <div class="flex flex-wrap gap-x-8 gap-y-2 text-xs text-ink-60 mb-8" data-reveal>
      {shop.trustBadges.map((b) => <span>{b}</span>)}
    </div>
    <div class="flex flex-wrap gap-2" data-reveal>
      {shop.priceFilters.map((f) => (
        <button class="px-3 py-1.5 border border-ink/20 rounded-full text-xs hover:bg-ink hover:text-base transition-colors">{f}</button>
      ))}
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 md:px-8 pb-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3" data-reveal>
      {shop.categories.map((c) => (
        <div class="bg-base-90 border border-ink/10 rounded-lg px-4 py-3 text-sm text-center">{c}</div>
      ))}
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 md:px-8 pb-24">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
      {products.map((p) => (
        <ProductCard slug={p.id} name={p.data.name} price={p.data.price} image={p.data.images[0]} category={p.data.category} />
      ))}
    </div>
  </section>
</BaseLayout>
