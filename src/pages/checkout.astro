---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Checkout">
  <section class="max-w-2xl mx-auto px-4 md:px-8 py-16">
    <div class="flex items-center gap-2 mb-10 text-xs" id="stepper">
      <span data-step-label="shipping" class="step-pill px-3 py-1.5 rounded-full border border-ink">1. Spedizione</span>
      <span class="text-ink-60">→</span>
      <span data-step-label="summary" class="step-pill px-3 py-1.5 rounded-full border border-ink/20 text-ink-60">2. Riepilogo</span>
      <span class="text-ink-60">→</span>
      <span data-step-label="payment" class="step-pill px-3 py-1.5 rounded-full border border-ink/20 text-ink-60">3. Pagamento</span>
    </div>

    <div id="step-shipping" class="step">
      <h1 class="font-display text-3xl mb-6">Dati di spedizione</h1>
      <form id="shipping-form" class="space-y-4">
        <div class="grid md:grid-cols-2 gap-4">
          <input required placeholder="Nome" class="px-4 py-3 border border-ink/20 rounded bg-base" />
          <input required placeholder="Cognome" class="px-4 py-3 border border-ink/20 rounded bg-base" />
        </div>
        <input required placeholder="Indirizzo" class="w-full px-4 py-3 border border-ink/20 rounded bg-base" />
        <div class="grid md:grid-cols-3 gap-4">
          <input required placeholder="Città" class="px-4 py-3 border border-ink/20 rounded bg-base" />
          <input required placeholder="CAP" class="px-4 py-3 border border-ink/20 rounded bg-base" />
          <input required placeholder="Provincia" class="px-4 py-3 border border-ink/20 rounded bg-base" />
        </div>
        <button type="submit" class="px-8 py-3 bg-accent text-base rounded font-medium">Continua</button>
      </form>
    </div>

    <div id="step-summary" class="step hidden">
      <h1 class="font-display text-3xl mb-6">Riepilogo ordine</h1>
      <div id="summary-items" class="space-y-3 mb-6"></div>
      <div class="flex justify-between border-t border-ink/10 pt-4 mb-8 font-medium">
        <span>Totale</span>
        <span id="summary-total">€0,00</span>
      </div>
      <button id="to-payment" class="px-8 py-3 bg-accent text-base rounded font-medium">Vai al pagamento</button>
    </div>

    <div id="step-payment" class="step hidden">
      <h1 class="font-display text-3xl mb-6">Pagamento</h1>
      <div class="border-2 border-dashed border-accent/40 rounded-lg p-6 bg-accent/5">
        <p class="font-display text-lg text-accent mb-2">⚠ MODALITÀ DEMO – nessun pagamento reale</p>
        <p class="text-sm text-ink-60 mb-6">DEMO MODE – no real payment is processed. This is a non-functional preview for pitch purposes only.</p>

        <label class="block text-sm mb-1">Numero carta</label>
        <input type="text" value="•••• •••• •••• 4242" disabled class="w-full px-3 py-2 border border-ink/20 rounded bg-base-90 text-ink-60 cursor-not-allowed mb-4" />

        <button id="simulate-pay" class="mt-2 w-full py-3 bg-accent text-base rounded font-medium">Simula pagamento</button>
      </div>
    </div>

    <div id="step-confirmation" class="step hidden text-center py-12">
      <h1 class="font-display text-3xl mb-4">Ordine confermato ✓</h1>
      <p class="text-ink-60 mb-2">Numero ordine demo:</p>
      <p id="order-id" class="font-display text-2xl text-accent mb-8"></p>
      <p class="text-xs text-ink-60 mb-8">Nessun pagamento reale è stato effettuato. Questo è un ordine simulato a scopo dimostrativo.</p>
      <a href="/" class="px-8 py-3 bg-ink text-base rounded font-medium inline-block">Torna alla home</a>
    </div>
  </section>
</BaseLayout>

<script>
  import { cart, cartTotal, clearCart } from '../stores/cart';

  const fmt = (n: number) => n.toLocaleString('it-IT', { style: 'currency', currency: 'EUR' });
  const steps = ['shipping', 'summary', 'payment', 'confirmation'];

  function showStep(name: string) {
    steps.forEach((s) => document.getElementById(`step-${s}`)?.classList.toggle('hidden', s !== name));
    document.querySelectorAll<HTMLElement>('.step-pill').forEach((el) => {
      const active = el.dataset.stepLabel === name;
      el.classList.toggle('border-ink', active);
      el.classList.toggle('border-ink/20', !active);
      el.classList.toggle('text-ink-60', !active);
    });
  }

  document.getElementById('shipping-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    renderSummary();
    showStep('summary');
  });

  function renderSummary() {
    const items = cart.get();
    const container = document.getElementById('summary-items')!;
    container.innerHTML = items.map((i) => `
      <div class="flex justify-between text-sm">
        <span>${i.name} × ${i.qty}</span>
        <span>${fmt(i.price * i.qty)}</span>
      </div>
    `).join('') || '<p class="text-sm text-ink-60">Nessun articolo nel carrello.</p>';
    document.getElementById('summary-total')!.textContent = fmt(cartTotal(items));
  }

  document.getElementById('to-payment')?.addEventListener('click', () => showStep('payment'));

  document.getElementById('simulate-pay')?.addEventListener('click', () => {
    const orderId = 'DEMO-' + Math.random().toString(36).slice(2, 8).toUpperCase();
    document.getElementById('order-id')!.textContent = orderId;
    clearCart();
    showStep('confirmation');
  });
</script>
