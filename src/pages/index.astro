---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import content from '../data/content.json';
import { getCollection } from 'astro:content';

const products = (await getCollection('products')).slice(0, 3);
const { business, home, about } = content;
---
<BaseLayout title="Home">
  <section class="relative h-[85vh] min-h-[560px] flex items-end overflow-hidden">
    <img
      src="https://vahidtappetirari.it/wp-content/uploads/2020/12/inkedimg_20181018_092746_li-scaled.jpg"
      alt="Tappeto persiano antico in primo piano"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink/90 via-ink/30 to-ink/10"></div>
    <div class="relative max-w-7xl mx-auto px-4 md:px-8 pb-16 md:pb-24 text-base w-full">
      <p class="text-xs uppercase tracking-[0.2em] text-base/70 mb-4" data-reveal>{home.heroEyebrow}</p>
      <h1 class="font-display text-5xl md:text-7xl max-w-2xl leading-[1.05]" data-reveal>{home.heroHeadline}</h1>
      <p class="mt-6 max-w-lg text-base/80" data-reveal>{home.bodyCopy[0]}</p>
      <div class="mt-8 flex items-center gap-6" data-reveal>
        <a href="/shop" class="px-6 py-3 bg-accent rounded font-medium">Scopri i tappeti</a>
        <div class="flex items-baseline gap-1">
          <span class="font-display text-4xl" data-count={business.experienceYears}>0</span>
          <span class="text-sm text-base/70">anni di esperienza</span>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 md:px-8 py-24 grid md:grid-cols-2 gap-12 items-center">
    <div data-reveal>
      <p class="text-xs uppercase tracking-wide text-accent mb-3">Chi siamo</p>
      <h2 class="font-display text-3xl md:text-4xl mb-5">Tappeti rari e unici</h2>
      <p class="text-ink-80 mb-6">{about.bio}</p>
      <a href="/chi-siamo" class="text-accent font-medium underline underline-offset-4">Scopri la nostra storia →</a>
    </div>
    <div class="grid grid-cols-3 gap-3" data-reveal>
      {about.coreValues.map((v) => (
        <div class="bg-ink text-base rounded-lg p-5 aspect-square flex items-end">
          <span class="font-display text-lg">{v}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 md:px-8 py-16">
    <div class="flex items-end justify-between mb-8" data-reveal>
      <h2 class="font-display text-3xl md:text-4xl">Tappeti in evidenza</h2>
      <a href="/shop" class="text-sm text-accent font-medium">Vedi tutti →</a>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-6 md:gap-8">
      {products.map((p) => (
        <ProductCard slug={p.id} name={p.data.name} price={p.data.price} image={p.data.images[0]} category={p.data.category} />
      ))}
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-4 md:px-8 py-16" data-reveal>
    <h2 class="font-display text-3xl md:text-4xl mb-8">Lavaggio e restauro</h2>
    <div class="grid md:grid-cols-2 gap-8 items-center">
      <p class="text-ink-80">{home.bodyCopy[1]} {home.bodyCopy[2]}</p>
      <a href="/lavaggio-e-restauro" class="inline-block px-6 py-3 border border-ink rounded font-medium w-fit">Scopri il restauro →</a>
    </div>
  </section>

  <section class="relative h-[60vh] min-h-[420px] flex items-center justify-center text-center overflow-hidden">
    <img src="https://vahidtappetirari.it/wp-content/uploads/2020/12/dsc00812_li-scaled.jpg" alt="Tappeto persiano Kashkuli" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-ink/60"></div>
    <div class="relative text-base px-4" data-reveal>
      <h2 class="font-display text-3xl md:text-5xl mb-6 max-w-xl mx-auto">Vieni a scoprire la nostra selezione a Pescara</h2>
      <a href="/contatti" class="inline-block px-8 py-3 bg-accent rounded font-medium">Contattaci</a>
    </div>
  </section>
</BaseLayout>
